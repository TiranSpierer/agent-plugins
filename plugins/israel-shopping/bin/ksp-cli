#!/usr/bin/env node
const { spawnSync } = require("node:child_process");

// On Windows, .cmd files cannot be spawned directly — they require cmd.exe.
// Use ["cmd", "/c", "npx.cmd", ...args] instead of shell:true to avoid
// shell escaping issues with user-supplied arguments.
const [executable, npxArgs] =
  process.platform === "win32"
    ? ["cmd", ["/c", "npx.cmd"]]
    : ["npx", []];

const result = spawnSync(
  executable,
  [
    ...npxArgs,
    "--prefer-online",
    "-y",
    "-p",
    "git+https://github.com/TiranSpierer/ksp-cli.git#main",
    "ksp-cli",
    ...process.argv.slice(2),
  ],
  {
    stdio: ["pipe", "inherit", "inherit"],
    env: {
      ...process.env,
      npm_config_loglevel: "silent",
      npm_config_update_notifier: "false",
    },
  },
);

if (result.error) {
  console.error(result.error.message);
  process.exit(1);
}
process.exit(result.status ?? 1);
